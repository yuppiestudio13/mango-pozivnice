# sirove fotografije (4,4 GB) – ne idu na sajt
mango-slike/
# alati i sistemski fajlovi
.claude/
.playwright-mcp/
.DS_Store
# stare rezervne verzije (istorija je sada u git-u)
*-backup.html
# izvorni PDF šabloni (u njima su ugrađeni plaćeni fontovi) – ne idu na sajt
sabloni/pdf/

# Fontovi: licence potvrđene (2026-11-05). Na sajt idu samo fontovi.css i woff2 iz fontovi/web,
# izvorni fajlovi (ttf/otf/eot, demo, probe) ostaju samo na računaru.
fontovi/*
!fontovi/fontovi.css
!fontovi/web/
fontovi/web/*
!fontovi/web/*.woff2
